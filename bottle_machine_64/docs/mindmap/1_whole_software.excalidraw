part.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The app suggests from BOM words ('belt', 'disk', 'brushless'); you confirm. 9 types so far: DC\nmotor, brushless motor, shaft, rotating disk, drive pulley, idler pulley, belt, flipper arm, fixed part.", "lineHeight": 1.25, "autoResize": true}, {"id": "0189220e4609455e861e", "type": "rectangle", "x": 880, "y": 956.75, "width": 700, "height": 122.75, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9bdb07a4489c"], "frameId": null, "roundness": {"type": 3}, "seed": 986990923, "version": 1, "versionNonce": 2044929404, "isDeleted": false, "boundElements": [{"id": "df7254c09917411480f2", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "a2a355a282414b7589fe", "type": "text", "x": 896, "y": 972.75, "width": 86.8, "height": 17.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9bdb07a4489c"], "frameId": null, "roundness": null, "seed": 622301270, "version": 1, "versionNonce": 1989657837, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "linking.py", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "linking.py", "lineHeight": 1.25, "autoResize": true}, {"id": "e5d6a80113aa426b81b6", "type": "text", "x": 896, "y": 994.25, "width": 162.51625, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9bdb07a4489c"], "frameId": null, "roundness": null, "seed": 46148795, "version": 1, "versionNonc