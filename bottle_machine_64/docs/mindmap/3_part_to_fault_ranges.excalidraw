, "points": [[0, 0], [0.0, 34.0]], "lastCommittedPoint": null, "startArrowhead": null, "endArrowhead": "arrow", "startBinding": {"elementId": "96733d330b6145e89b24", "focus": 0, "gap": 1}, "endBinding": {"elementId": "5ad1d92644644cb8beed", "focus": 0, "gap": 1}, "elbowed": false}, {"id": "fa0cc2d0bd0948f3a6a5", "type": "rectangle", "x": 2360, "y": 610.25, "width": 520, "height": 287.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["bbd0dcdb2f7b"], "frameId": null, "roundness": {"type": 3}, "seed": 934658577, "version": 1, "versionNonce": 1394874356, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "1e7494401d8b47a1adf8", "type": "text", "x": 2376, "y": 626.25, "width": 211.2825, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["bbd0dcdb2f7b"], "frameId": null, "roundness": null, "seed": 1499086196, "version": 1, "versionNonce": 208354003, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "What this does not do yet", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "originalText": "What this does not do yet", "lineHeight": 1.25, "autoResize": true}, {"id": "4a9389c34e1c405c9e6a", "type": "text", "x": 2376, "y": 656.75, "width": 476.72625, "height": 225.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["bbd0dcdb2f7b"], "frameId": null, "roundness": null, "seed": 218703371, "version": 1, "versionNonce": 1290045253, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "- Loads adding up where two parts share one driver\n- Two faults at the same time\n- Loops in the drive chain\n- Speed and vibration patterns (only the size of the current change is\nused, so parts near each other cannot be told apart)\n- Gear and chain ratios between motor and part (the validated gear\nmodel is not wired in)\n- Only 9 part types; the Bottle Machine 64 needs more (gearheads,\nchain, slew-bearing disk)\n- The touch force scale itself is unproven until a recording with known\nforces is made\n- Reading real sensor ports (only replay exists)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "- Loads adding up where two parts share one driver\n- Two faults at the same time\n- Loops in the drive chain\n- Speed and vibration patterns (only the size of the current change is\nused, so parts near each other cannot be told apart)\n- Gear and chain ratios between motor and part (the validated gear\nmodel is not wired in)\n- Only 9 part types; the Bottle Machine 64 needs more (gearheads,\nchain, slew-bearing disk)\n- The touch force scale itself is unproven until a recording with known\nforces is made\n- Reading real sensor ports (only replay exists)", "lineHeight": 1.25, "autoResize": true}, {"id": "becd0ab74358407f843f", "type": "text", "x": 0, "y": 1449.75, "width": 88.66, "height": 16.25, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 691416675, "version": 1, "versionNonce": 2038282104, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "COLOUR KEY", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "COLOUR KEY", "lineHeight": 1.25, "autoResize": true}, {"id": "1f8bc9e636