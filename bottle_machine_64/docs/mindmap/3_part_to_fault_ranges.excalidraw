: 1272753160, "version": 1, "versionNonce": 1291614068, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Live use (replayed with faked readings)", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 19, "containerId": null, "originalText": "Live use (replayed with faked readings)", "lineHeight": 1.25, "autoResize": true}, {"id": "8dcf732bfc3440f29591", "type": "rectangle", "x": 1730, "y": 610.25, "width": 540, "height": 76.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0ed4a8b4256e"], "frameId": null, "roundness": {"type": 3}, "seed": 687249291, "version": 1, "versionNonce": 381008750, "isDeleted": false, "boundElements": [{"id": "63719366a8c247e0a7a2", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "750acdf004214f52b056", "type": "text", "x": 1744, "y": 624.25, "width": 271.65125, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0ed4a8b4256e"], "frameId": null, "roundness": null, "seed": 781587613, "version": 1, "versionNonce": 397812860, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Belt motor current rises by +0.30 A", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "originalText": "Belt motor current rises by +0.30 A", "lineHeight": 1.25, "autoResize": true}, {"id": "bde32dc162ee47879c48", "type": "text", "x": 1744, "y": 653.5, "width": 498.77750000000003, "height": 18.75, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0ed4a8b4256e"], "frameId": null, "roundness": null, "seed": 671455125, "version": 1, "versionNonce": 1628022667, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The sensor says the belt motor draws 0.30 A more than its normal 0.9 A.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "The sensor says the belt motor draws 0.30 A more than its normal 0.9 A.", "lineHeight": 1.25, "autoResize": true}, {"id": "fc03d8d4344a43cb8257", "type": "rectangle", "x": 1730, "y": 720.25, "width": 540, "height": 153.75, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["264872dba9d1"], "frameId": null, "roundness": {"type": 3}, "seed": 792752128, "version": 1, "versionNonce": 1812134634, "isDeleted": false, "boundElements": [{"id": "63719366a8c247e0a7a2", "type": "arrow"}, {"id": "6f03c91321514eda9bbd", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "1dd57327ca35488493b0", "type": "text", "x": 1744, "y": 734.25, "width": 156.24, "height": 17.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["264872dba9d1"], "frameId": null, "roundness": null, "seed": 1279087455, "version": 1, "versionNonce": 567230421, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "live_match.match()", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "live_match.match()", "lineHeight": 1.25, "autoResize": true}, {"id": "f790ce08c8b447fcb67a", "type": "text", "x": 1744, "y": 755.75, "width": 266.32125, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["264872dba9d1"], "frameId": null, "roundness": null, "seed": 645112619, "version": 1, "versionNonce": 1690717993, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Which parts could explain 0.30 A?", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "originalText": "Which parts could explain 0.30 A?", "lineHeight": 1.25, "autoResize": true}, {"id": "4e92307bf8ec4238a06b", "type": "text", "x": 1744, "y": 785.0, "width": 336.84625, "height": 75.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["264872dba9d1"], "frameId": null, "roundness": null, "seed": 809945677, "version": 1, "versionNonce": 225210312, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Flipper arm: yes, at about 32.5 N (warning band)\nTiming belt: yes, at about 32.5 N (elevated band)\nIdler pulley: no, its biggest possible is +0.263 A\nDrive pulley: has no load model of its own", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Flipper arm: yes, at about 32.5 N (warning band)\nTiming belt: yes, at about 32.5 N (elevated band)\nIdler pulley: no, its biggest possible is +0.263 A\nDrive pulley: has no load model of its own", "lineHeight": 1.25, "autoResize": true}, {"id": "96733d330b6145e89b24", "type": "rectangle", "x": 1730, "y": 908.0, "width": 540, "height": 94.75, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["77d6f1fe2648"], "frameId": null, "roundness": {"type": 3}, "seed": 1658444522, "version": 1, "versionNonce": 1746026279, "isDeleted": false, "boundElements": [{"id": "6f03c91321514eda9bbd", "type": "arrow"}, {"id": "7ffee94647f64f78957a", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "db05509ce7944fed9978", "type": "text", "x": 1744, "y": 922.0, "width": 163.1175, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["77d6f1fe2648"], "frameId": null, "roundness": null, "seed": 57812848, "version": 1, "versionNonce": 2086010860, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Answer: Belt Section", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "originalText": "Answer: Belt Section", "lineHeight": 1.25, "autoResize": true}, {"id": "28bbad8b46e44ad387fe", "type": "text", "x": 1744, "y": 951.25, "width": 484.5425, "height": 37.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["77d6f1fe2648"], "frameId": null, "roundness": null, "seed": 1222472246, "version": 1, "versionNonce": 1468305115, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Two parts could do it, both in the Belt Section, so it names the section\ninstead of picking one. The wireframe lights up the whole Belt Section.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Two parts could do it, both in the Belt Section, so it names the section\ninstead of picking one. The wireframe lights up the whole Belt Section.", "lineHeight": 1.25, "autoResize": true}, {"id": "5ad1d92644644cb8beed", "type": "rectangle", "x": 1730, "y": 1036.75, "width": 540, "height": 94.75, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5cdfe6a0093a"], "frameId": null, "roundness": {"type": 3}, "seed": 1578772390, "version": 1, "versionNonce": 282223984, "isDeleted": false, "boundElements": [{"id": "7ffee94647f64f78957a", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "04ab498d5f4c4fe49823", "type": "text", "x": 1744, "y": 1050.75, "width": 193.115, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5cdfe6a0093a"], "frameId": null, "roundness": null, "seed": 665755783, "version": 1, "versionNonce": 1073764845, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "If it were +0.60 A instead", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "originalText": "If it were +0.60 A instead", "lineHeight": 1.25, "autoResize": true}, {"id": "f8a47dcabb9c4a4cbae6", "type": "text", "x": 1744, "y": 1080.0, "width": 501.93, "height": 37.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5cdfe6a0093a"], "frameId": null, "roundness": null, "seed": 477896379, "version": 1, "versionNonce": 1403860049, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Only the Timing Belt is big enough. The answer is that one part, and only\nit lights up.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Only the Timing Belt is big enough. The answer is that one part, and only\nit lights up.", "lineHeight":