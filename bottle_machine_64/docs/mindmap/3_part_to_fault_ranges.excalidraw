idth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e0400e18e7f5"], "frameId": null, "roundness": null, "seed": 1887351791, "version": 1, "versionNonce": 784947490, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "orchestration", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "orchestration", "lineHeight": 1.25, "autoResize": true}, {"id": "b9916e6aa0974005bed8", "type": "text", "x": 16, "y": 367.5, "width": 240.5325, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e0400e18e7f5"], "frameId": null, "roundness": null, "seed": 209281551, "version": 1, "versionNonce": 77065968, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Who runs what, and when", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "originalText": "Who runs what, and when", "lineHeight": 1.25, "autoResize": true}, {"id": "106f17ba52704edbbe3a", "type": "text", "x": 16, "y": 400.5, "width": 950.34875, "height": 93.75, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e0400e18e7f5"], "frameId": null, "roundness": null, "seed": 291990910, "version": 1, "versionNonce": 1062754043, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "builder.build() is the conductor. It validates, writes the folders, then starts one process per part and runs them side by side (parallel across\nparts).\nInside one part the formula steps always run in a fixed order, one after another (series): load -> torque at the part -> torque at the motor ->\ncurrent.\nToday parts never feed each other, so nothing has to wait. Loads adding up at a shared driver are the next thing to build.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "builder.build() is the conductor. It validates, writes the folders, then starts one process per part and runs them side by side (parallel across\nparts).\nInside one part the formula steps always run in a fixed order, one after another (series): load -> torque at the part -> torque at the motor ->\ncurrent.\nToday parts never feed each other, so nothing has to wait. Loads adding up at a shared driver are the next thing to build.", "lineHeight": 1.25, "autoResize": true}, {"id": "d8837131e6e04efda54f", "type": "rectangle", "x": 1060, "y": 330, "width": 1000, "height": 124.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e67f22aa0d7c"], "frameId": null, "roundness": {"type": 3}, "seed": 465975919, "version": 1, "versionNonce": 554010464, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "ede96c49c6444643a235", "type": "text", "x": 1076, "y": 346, "width": 130.2, "height": 17.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e67f22aa0d7c"], "frameId": null, "roundness": null, "seed": 2073352805, "version": 1, "versionNonce": 1443197554, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "runtime.apply()", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "runtime.apply()", "lineHeight": 1.25, "autoResize": true}, {"id": "580f0435dcba4f52862b", "type": "text", "x": 1076, "y": 367.5, "width": 424.3525, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e67f22aa0d7c"], "frameId": null, "roundness": null, "seed": 936650470, "version": 1, "versionNonce": 1672830882, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The zero-guess guard inside every calculation", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "originalText": "The zero-guess guard inside every calculation", "lineHeight": 1.25, "autoResize": true}, {"id": "ac48680632bf4332bede", "type": "text", "x": 1076, "y": 400.5, "width": 959.6437500000001, "height": 37.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e67f22aa0d7c"], "frameId": null, "roundness": null, "seed": 1345716945, "version": 1, "versionNonce": 1836582958, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Every number is computed through one function, apply(). It takes ONE formula from the project's stock, solves it for the asked variable, and\nrefuses if an input is missing or if an input is passed that the formula does not use. There are no default values anywhere.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Every number is computed through one function, apply(). It takes ONE formula from the project's stock, solves it for the asked variable, and\nrefuses if an input is missing or if an input is passed that the formula does not use. There are no default values anywhere.", "lineHeight": 1.25, "autoResize": true}, {"id": "a1ff6496927742e2a0ef", "type": "text", "x": 0, "y": 564.25, "width": 327.36, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 646448840, "version": 1, "versionNonce": 904409542, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Example A: rotating disk", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 19, "containerId": null, "originalText": "Example A: rotating disk", "lineHeight": 1.25, "autoResize": true}, {"id": "d0f6e5125c27401eb353", "type": "rectangle", "x": 0, "y": 610.25, "width": 470, "height": 76.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["1d22158a7f48"], "frameId": null, "roundness": {"type": 3}, "seed": 1089296009, "version": 1, "versionNonce": 1789878483, "isDeleted": false, "boundElements": [{"id": "7168cf17b45f4ceeb085", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "9334981d4de64f7895a5", "type": "text", "x": 14, "y": 624.25, "width": 380.185, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["1d22158a7f48"], "frameId": null, "roundness": null, "seed": 828641475, "version": 1, "versionNonce": 1232704446, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Start: a stuck bottle presses 20 N on the disk rim", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "originalText": "Start: a stuck bottle presses 20 N on the disk rim", "lineHeight": 1.25, "autoResize": true}, {"id": "e91dd7908cc14e6984e1", "type": "text", "x": 14, "y": 653.5, "width": 321.65250000000003, "height": 18.75, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["1d22158a7f48"], "frameId": null, "roundness": null, "seed": 753574531, "version": 1, "versionNonce": 1146977645, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "20 N is the 'warning' level typed in for this part.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "20 N is the 'warning' level typed in for this part.", "lineHeight": 1.25, "autoResize": true}, {"id": "e5a4b3c09a1942369f53", "type": "rectangle", "x": 0, "y": 720.25, "width": 470, "height": 135.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b79700dd05b5"], "frameId": null, "roundness": {"type": 3}, "seed": 1256437083, "version": 1, "versionNonce": 875262510, "isDeleted": false, "boundElements": [{"id": "7168cf17b45f4ceeb085", "type": "arrow"}, {"id": "94e3e050004443e89831", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "7a7e3444823a4e6f892d", "type": "text", "x": 14, "y": 734.25, "width": 225.68, "height": 17.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b79700dd05b5"], "frameId": null, "roundness": null, "seed": 1254671179, "version": 1, "versionNonce": 499046147, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "formula: disc_brake_torque", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "originalText": "formula: disc_brake_torque"